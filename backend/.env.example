# 复制本文件为 .env 并填入实际值（.env 已被 gitignore，不会提交）

# 应用
APP_NAME=RecipeHub
DEBUG=false

# SQLite 数据库
DATABASE_URL=sqlite:///./recipehub.db

# Qdrant 向量数据库
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM / Embedding（OpenAI 兼容 API）
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
# LLM 温度：默认 1.0。推理模型（如 Kimi K3）只允许 1，普通对话模型可调低到 0.3
LLM_TEMPERATURE=1.0
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 向量维度必须与 EMBEDDING_MODEL 一致（BGE-small-zh-v1.5 → 512）；换模型需改此值并重建 Collection
EMBEDDING_DIM=512

# 微信小程序（正式登录时使用）
WECHAT_APPID=
WECHAT_APPSECRET=
