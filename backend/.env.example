# 复制本文件为 .env 并填入实际值（.env 已被 gitignore，不会提交）

# 应用
APP_NAME=RecipeHub
DEBUG=false

# SQLite 数据库
DATABASE_URL=sqlite:///./recipehub.db

# Qdrant 向量数据库
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM / Embedding（OpenAI 兼容 API）
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 微信小程序（正式登录时使用）
WECHAT_APPID=
WECHAT_APPSECRET=
